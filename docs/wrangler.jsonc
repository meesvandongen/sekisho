{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sekisho-docs",
  "compatibility_date": "2026-11-01",
  // Static-assets-only Worker: `next build` exports the site to ./out.
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "sekisho.mvd.im",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
